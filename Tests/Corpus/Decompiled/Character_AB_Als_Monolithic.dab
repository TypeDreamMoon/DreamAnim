                MultiWayBlend(
                    Poses         = [
                        CrouchingForward,
                        CrouchingBackward,
                        CrouchingLeftBackward,
                        CrouchingRightForward
                    ],
                    DesiredAlphas = [
                        Self.GroundedState.VelocityBlend.ForwardAmount,
